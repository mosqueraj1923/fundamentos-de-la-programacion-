    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Kilometro, Velocidad, Tiempo" type="Real" array="False" size=""/>
            <output expression="&quot;Indique el Kilometraje&quot;" newline="True"/>
            <input variable="Kilometro"/>
            <output expression="&quot;Moviendose a una velocidad constante de 20Km/H&quot;" newline="True"/>
            <assign variable="Velocidad" expression="20"/>
            <assign variable="Tiempo" expression="Kilometro/Velocidad"/>
            <output expression="&quot;el tiempo que le tomara es de &quot;&amp;Tiempo&amp;&quot; horas&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
