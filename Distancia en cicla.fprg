<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Distancia en cicla"/>
        <attribute name="authors" value="Usuario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-18 09:03:28 p.&#160;m."/>
        <attribute name="created" value="VXN1YXJpbztERVNLVE9QLUZSTzc1Qzk7MjAyNi0wNC0xODswODo1MTo0NyBwLsKgbS47MzM5OA=="/>
        <attribute name="edited" value="VXN1YXJpbztERVNLVE9QLUZSTzc1Qzk7MjAyNi0wNC0xODswOTowMzoyOCBwLsKgbS47MTszNTAz"/>
