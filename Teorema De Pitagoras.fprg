    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Hipotenusa, CatetoAd, CatetoOp, Resultado, Conversion" type="Real" array="False" size=""/>
            <output expression="&quot;Indique el numero del cateto Adyasente&quot;" newline="True"/>
            <input variable="CatetoAd"/>
            <output expression="&quot;Indique el numero de su cateto Opuesto&quot;" newline="True"/>
            <input variable="CatetoOp"/>
            <assign variable="Hipotenusa" expression="sqrt((CatetoAd^2) + (CatetoOp^2))"/>
            <output expression="&quot;La Hipotenusa es: &quot; &amp;Hipotenusa&amp; &quot;.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
