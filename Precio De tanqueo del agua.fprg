<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Precio De tanqueo del agua"/>
        <attribute name="authors" value="Usuario"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-18 09:05:52 p.&#160;m."/>
        <attribute name="created" value="VXN1YXJpbztERVNLVE9QLUZSTzc1Qzk7MjAyNi0wNC0xODswODoyNToxNyBwLsKgbS47MzM5Ng=="/>
        <attribute name="edited" value="VXN1YXJpbztERVNLVE9QLUZSTzc1Qzk7MjAyNi0wNC0xODswOTowNTo1MiBwLsKgbS47MjszNTAz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PrecioAgua, Alto, Largo, Ancho, Formula, PrecioTotal" type="Real" array="False" size=""/>
            <assign variable="PrecioAgua" expression="100000"/>
            <output expression="&quot;Indique la Profundidad de la piscina&quot;" newline="True"/>
            <input variable="Alto"/>
            <output expression="&quot;Indique el largo de la piscina&quot;" newline="True"/>
            <input variable="Largo"/>
            <output expression="&quot;Indique el ancho de la piscina&quot;" newline="True"/>
            <input variable="Ancho"/>
            <assign variable="PrecioTotal" expression="(Alto*Largo*Ancho)*PrecioAgua"/>
            <output expression="&quot;Su precio total es de: &quot;&amp;PrecioTotal&amp; &quot;.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
